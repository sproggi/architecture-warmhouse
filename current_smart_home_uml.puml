@startuml smart_home
!include ./c4_templates/C4_Context.puml

title Контекстная диаграмма - Умный дом

' Внешние системы
Person(users, "Пользователи", "Владельцы домов")

System_Ext(house1, "Дом 1", "Датчики системы отопления")
System_Ext(house2, "Дом 2", "Датчики системы отопления")
System_Ext(houseN, "Дом N", "Датчики системы отопления")

' === Основное приложение ===
System(smart_home, "Умный дом", "Центральный контроллер\nУправляет датчиками и отоплением")

' === Связи ===
Rel(users, smart_home, "Управляют режимами\nПросматривают статистику")
Rel(smart_home, house1, "Управляет отоплением")
Rel(smart_home, house2, "Управляет отоплением")
Rel(smart_home, houseN, "Управляет отоплением")

@enduml