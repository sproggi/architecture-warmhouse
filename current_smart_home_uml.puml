@startuml smart_home
!include ./c4_templates/C4_Context.puml

title Контекстная диаграмма - Умный дом

Person(users, "Пользователи", "Владельцы домов")

System_Ext(house1, "Дом 1", "Система отопления")
System_Ext(house2, "Дом 2", "Система отопления")
System_Ext(houseN, "Дом N", "Система отопления")

System_Ext(sensors, "Датчики температуры", "Регистрируются при включении\nПередают показания")


System(smart_home, "Умный дом", "Центральный контроллер\nУправляет датчиками и отоплением")

System_Ext(db, "База данных", "Хранит показания датчиков\nНастройки пользователей\nИсторию событий")

Rel(users, smart_home, "Управляют режимами\nПросматривают статистику")

Rel(smart_home, house1, "Управляет отоплением")
Rel(smart_home, house2, "Управляет отоплением")
Rel(smart_home, houseN, "Управляет отоплением")

Rel(sensors, smart_home, "Регистрируются\nПередают показания")

Rel(smart_home, db, "Читает/записывает данные", "SQL")

@enduml